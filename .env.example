# Circuit Design & Robustness Analysis Platform - Environment Configuration
# Copy this file to .env and modify values as needed

# Server Configuration
DEBUG=false
LOG_LEVEL=info

# Ollama API Configuration (for AI explanations)
# Leave as-is if running Ollama locally, or modify if using remote instance
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Optional: Timeout for Ollama requests (seconds)
OLLAMA_TIMEOUT=30

# Optional: Enable/disable features
ENABLE_EXPLANATIONS=true
ENABLE_MATLAB_EXPORT=true
ENABLE_CSV_EXPORT=true

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Backend protections
# Keep the default local-only binding. Set a long random value if exposing the API.
BACKEND_API_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_REQUEST_BYTES=2097152
RATE_LIMIT_PER_MINUTE=120
OPEN_BROWSER=true
# Set true for a public release if API documentation should be hidden.
DISABLE_API_DOCS=false

# Frontend
FRONTEND_PATH=./frontend
